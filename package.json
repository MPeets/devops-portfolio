{
  "name": "devops-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio site. Plain HTML, CSS and JavaScript, tested in CI and deployed to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:html": "html-validate \"site/**/*.html\"",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run lint:html && npm test",
    "serve": "python3 -m http.server 8000 --directory site"
  },
  "devDependencies": {
    "html-validate": "^11.17.0",
    "jsdom": "^30.1.3"
  }
}
